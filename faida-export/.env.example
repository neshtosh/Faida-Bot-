# Faida Bot — Environment Config
# Copy this to .env and fill in your values

# ── WhatsApp ──────────────────────────────────────────────
# Leave blank when using Baileys (QR scan method)
# Fill in if using WhatsApp Cloud API (Meta Business)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=faida_webhook_verify_2026

# ── App ───────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
BOT_NAME=Faida
# Optional: public URL for shareable QR links
# Railway: set this to https://YOUR-SERVICE.up.railway.app after generating a domain
PUBLIC_URL=
# Required in production. The /qr pairing page only opens with ?token=<this value>
# (anyone who scans that QR links their WhatsApp as the bot).
# Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
QR_ACCESS_TOKEN=

# ── Supabase (for production database) ───────────────────
# Sign up free at supabase.com
# — Get these from Supabase Dashboard → Project Settings → API
# — Either ANON_KEY or SERVICE_ROLE_KEY is enough; the client prefers
#   SERVICE_ROLE_KEY when present (needed for RLS writes to sessions, etc.)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MUST be a RANDOM string, at least 32 chars.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FAIDA_HASH_SALT=change-this-to-a-random-string

# Encrypts personal data stored in Supabase: ID / KRA / bank / M-Pesa numbers
# in application forms, and the WhatsApp number of users who send
# REMINDERS ON (so reminders survive restarts — needs migration 08).
# Without it, those values are never written to the database (forms in
# progress are lost on restart, reminders reach only recent users).
# Changing it makes stored values unreadable. (Old name REMINDER_ENCRYPTION_KEY
# still works.)
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FAIDA_ENCRYPTION_KEY=

# Shown in the privacy notice as the contact for data requests,
# e.g. privacy@yourorg.co.ke or a phone number. Strongly recommended.
PRIVACY_CONTACT=

# ── Optional: Override path to shared benefits.json (default is ../src/db/benefits.json) ──
# FAIDA_BENEFITS_JSON=

# ── AI Assistant (OpenAI or Anthropic) ────────────────────
# Set AI_PROVIDER to force one, or leave blank to auto-detect.
# OpenAI is preferred when OPENAI_API_KEY is set.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic alternative (console.anthropic.com)
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 when blank
ANTHROPIC_MODEL=

# ── M-Taji partner (live opportunities) ───────────────────
# Ask M-Taji for read access to their opportunities API.
# Same Supabase project that powers https://www.m-taji.co.ke/opportunities
MTAJI_SUPABASE_URL=
MTAJI_SUPABASE_ANON_KEY=
