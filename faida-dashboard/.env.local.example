# Faida Admin Dashboard — Environment Config
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Supabase (project-level settings) ────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
#
# ⚠️  SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security (RLS).
#     Keep it SERVER-SIDE ONLY. It is used by Next.js route handlers
#     under /app/api/* — never expose it to the browser.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...paste.service_role.key.here

# ── Shared benefits.json location ────────────────────────
# The dashboard writes benefit edits directly to a JSON file so
# the WhatsApp bot sees changes instantly (no rebuild needed).
# Relative paths are resolved from the dashboard project root.
#
# Default (when this variable is commented out / unset):
#   ../faida-export/src/db/benefits.json
#
# FAIDA_BENEFITS_JSON=C:\projects\faida\faida-export\src\db\benefits.json

# ── Privacy hash salt ────────────────────────────────────
# MUST match FAIDA_HASH_SALT in faida-export/.env  (same value)
# Required for hashing phone numbers in the dashboard Users page
# and for matching user IDs between bot + dashboard records.
FAIDA_HASH_SALT=change-this-to-the-SAME-value-as-in-bot-dot-env
