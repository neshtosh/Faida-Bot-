# Faida Admin Dashboard — Environment Config
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Supabase (project-level settings) ────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
#
# ⚠️  SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security (RLS).
#     Keep it SERVER-SIDE ONLY. It is used by Next.js route handlers
#     under /app/api/* — never expose it to the browser.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...paste.service_role.key.here

# ── Admin login (required) ───────────────────────────────
# Every page and API route requires signing in with this password (8+ chars).
# Changing it signs everyone out. Optionally set ADMIN_SESSION_SECRET to a
# separate random string to sign session cookies.
ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# ── Benefits catalog ─────────────────────────────────────
# When SUPABASE_* is set, benefits are stored in Supabase (works on Vercel).
# Without Supabase, the dashboard falls back to the local JSON file:
#   ../faida-export/src/db/benefits.json
#
# One-time seed: cd faida-export && npm run sync-benefits
# FAIDA_BENEFITS_JSON=C:\projects\faida\faida-export\src\db\benefits.json

# ── Optional: protect /api/cron/scrape if using an external cron service ──
# Not required for MVP — the Railway bot scrapes every 12h automatically.
# CRON_SECRET=generate-a-long-random-string-here

# ── M-Taji partner feed (optional) ───────────────────────
# Same keys as faida-export/.env — used when scraping opportunities.
MTAJI_SUPABASE_URL=https://YOUR-MTAJI-PROJECT.supabase.co
MTAJI_SUPABASE_ANON_KEY=eyJhbGciOi...paste.anon.key.here
